 "cenas": [
  { "id": "C01", "palavras": [0, 11],    "chave": 11,  "metafora": "Um cronômetro de 40 s começa a correr; a “pira” vira uma fita métrica girando em espiral, hipnótica." },
  { "id": "C02", "palavras": [12, 17],   "chave": 17,  "metafora": "Desespero de desenho animado: gotas de suor na cabeça dela; “parecer magra” é um espelho que espreme o reflexo." },
  { "id": "C03", "palavras": [18, 23],   "chave": 23,  "metafora": "“Mais que isso”: uma seta sobe e o desespero dobra (mais gotas de suor)." },
  { "id": "C04", "palavras": [24, 33],   "chave": 33,  "metafora": "A vida vira vitrine: um celular gravando um story com um prato de salada, curtidas subindo." },
  { "id": "C05", "palavras": [34, 40],   "chave": 40,  "metafora": "A internet grita num megafone: sinal de wi-fi + megafone que explode no “magra”." },
  { "id": "C06", "palavras": [41, 50],   "chave": 50,  "metafora": "Balança de pratos: o prato “magreza” pesa; o coração (saúde) cai no outro prato e é arremessado longe." },
  { "id": "C07", "palavras": [51, 59],   "chave": 52,  "metafora": "“Limpa” ao pé da letra: um borrifador de limpeza espirrando bolhas; a caneta risca o nome “alimentação limpa”." },
  { "id": "C08", "palavras": [60, 72],   "chave": 65,  "metafora": "O vilão está apavorado: um pão com medo, tremendo, que vira um pãozinho francês de boina." },
  { "id": "C09", "palavras": [73, 77],   "chave": 77,  "metafora": "Ring light com etiqueta de preço; uma lista de tarefas que desenrola até o chão." },
  { "id": "C10", "palavras": [78, 85],   "chave": 81,  "metafora": "“3x” circulado e três treinos aparecendo em fila: tênis, halter, tapete de yoga." },
  { "id": "C11", "palavras": [86, 91],   "chave": 91,  "metafora": "Balão de pensamento e os três treinos girando num malabarismo que quase cai." },
  { "id": "C12", "palavras": [92, 97],   "chave": 97,  "metafora": "Chega o relógio de ponto e o crachá “CLT”: o malabarismo despenca." },
  { "id": "C13", "palavras": [98, 103],  "chave": 103, "metafora": "Um pedaço de praia de verdade: sol, ondas e um guarda-sol fincado no “agora”." },
  { "id": "C14", "palavras": [104, 119], "chave": 119, "metafora": "Binóculos procuram esse corpo na praia e só acham num celular; um transferidor mede: é ângulo (45°)." },
  { "id": "C15", "palavras": [120, 129], "chave": 129, "metafora": "Uma lupa procura e encontra um bíceps definido, com riscos de “brilho” feitos à mão." },
  { "id": "C16", "palavras": [130, 138], "chave": 138, "metafora": "Definição vem do peso: uma seta leva do bíceps a um halter grande que sobe e desce." },
  { "id": "C17", "palavras": [139, 150], "chave": 149, "metafora": "O medo é de um halter minúsculo, com etiqueta “5 kg”, tremendo; as gotas de suor voltam." },
  { "id": "C18", "palavras": [151, 159], "chave": 159, "metafora": "A fábrica tem uma ideia (lâmpada): selo “+PROTEÍNA” em tudo, e sai dinheiro da chaminé." },
  { "id": "C19", "palavras": [160, 165], "chave": 165, "metafora": "Sacola de compras; até a garrafa de água ganha o selo “+PROTEÍNA”." }
 ],

