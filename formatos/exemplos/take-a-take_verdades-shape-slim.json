  { "id": "C02", "palavras": [7, 13],    "chave": 13,  "metafora": "Convite para relaxar: uma poltrona e uma xícara de chá fumegando." },
  { "id": "C03", "palavras": [14, 20],   "chave": 17,  "metafora": "200 abdominais viram risquinhos de contagem que enchem num instante e tremem de cansaço." },
  { "id": "C04", "palavras": [21, 24],   "chave": 24,  "metafora": "O prato da dieta, esquecido: ganha teia de aranha e cara triste." },
  { "id": "C05", "palavras": [25, 34],   "chave": 31,  "metafora": "Calendário da semana: ✓ de segunda a sexta." },
  { "id": "C06", "palavras": [35, 42],   "chave": 38,  "metafora": "O balde é chutado e voa longe; cai uma pizza e o fim de semana fica pintado." },
  { "id": "C07", "palavras": [43, 47],   "chave": 47,  "metafora": "Só cardio: um tênis correndo sem parar." },
  { "id": "C08", "palavras": [48, 53],   "chave": 51,  "metafora": "O halter deixado de lado, com teia de aranha." },
  { "id": "C09", "palavras": [54, 61],   "chave": 61,  "metafora": "Semana sem açúcar: cubinhos riscados no calendário e os cubos de açúcar levam um risco." },
  { "id": "C10", "palavras": [62, 70],   "chave": 66,  "metafora": "Beber igual um Opala: o carrão antigo com o ponteiro do combustível despencando para o vazio; caneca de chope ao lado." },
  { "id": "C11", "palavras": [71, 76],   "chave": 76,  "metafora": "Se entupir de proteína: o pote de whey transborda." },
  { "id": "C12", "palavras": [77, 81],   "chave": 81,  "metafora": "As fibras esquecidas: brócolis triste com teia de aranha." },
  { "id": "C13", "palavras": [82, 87],   "chave": 87,  "metafora": "Shape seco: uma barriga feminina “seca”, com tanquinho." },
  { "id": "C14", "palavras": [88, 96],   "chave": 90,  "metafora": "A balança de cozinha esquecida, com teia; a prancheta da dieta da nutri aparece." },
  { "id": "C15", "palavras": [97, 100],  "chave": 100, "metafora": "Drenagem: um rolinho de massagem rolando." },
  { "id": "C16", "palavras": [101, 105], "chave": 105, "metafora": "A garrafa de água esquecida, com teia de aranha, fecha a piada." }
